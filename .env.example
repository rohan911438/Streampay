# Shared Solana RPC endpoint for server-side modules (API + agents)
SOLANA_RPC_URL=https://your-helius-or-quicknode-endpoint

# Public endpoint used by frontend wallet/network access
# Set this to the same value as SOLANA_RPC_URL for consistent behavior.
NEXT_PUBLIC_SOLANA_RPC_URL=https://your-helius-or-quicknode-endpoint

# Dodo Payments server-side credentials and defaults
# Keep DODO_API_KEY private. Never expose it to client-side code.
DODO_API_KEY=sk_test_your_dodo_api_key
DODO_SUBSCRIPTION_PRODUCT_ID=prod_your_precreated_subscription_product

# Optional: override provider base URL (defaults to https://test.dodopayments.com)
# DODO_API_BASE_URL=https://test.dodopayments.com

# Optional redirect URLs attached to checkout session creation
# DODO_SUCCESS_URL=http://localhost:3000/pay/success
# DODO_CANCEL_URL=http://localhost:3000/pay/cancel

# Webhook signing secret used by POST /api/webhooks/dodo
DODO_WEBHOOK_SECRET=whsec_your_dodo_webhook_secret