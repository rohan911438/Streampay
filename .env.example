# Shared Solana RPC endpoint for server-side modules (API + agents)
SOLANA_RPC_URL=https://your-helius-or-quicknode-endpoint

# Public endpoint used by frontend wallet/network access
# Set this to the same value as SOLANA_RPC_URL for consistent behavior.
NEXT_PUBLIC_SOLANA_RPC_URL=https://your-helius-or-quicknode-endpoint