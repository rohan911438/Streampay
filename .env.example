# --- Solana Configuration ---
# Server-side RPC (High performance/Private)
RPC_URL=https://your-helius-or-quicknode-endpoint
# Legacy compatibility
SOLANA_RPC_URL=https://your-helius-or-quicknode-endpoint

# Client-side RPC (Publicly exposed)
NEXT_PUBLIC_RPC_URL=https://your-public-rpc-endpoint
NEXT_PUBLIC_RPC_ENDPOINT=https://your-public-rpc-endpoint

# Treasury Wallet where funds are collected
TREASURY_WALLET=C71EVTrMapBa7vPnvGaNd9qJu6XQkMhZn5iNPcADGGbV
NEXT_PUBLIC_TREASURY_WALLET=C71EVTrMapBa7vPnvGaNd9qJu6XQkMhZn5iNPcADGGbV

# --- Database ---
# PostgreSQL connection string for persistent storage
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- App URL ---
# Required for absolute URLs in metadata, callbacks, and webhooks
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# --- Cross-Chain APIs ---
LIFI_API_KEY=your_lifi_api_key
JUPITER_API_KEY=your_jupiter_api_key

# --- Dodo Payments ---
DODO_API_KEY=sk_test_your_dodo_api_key
DODO_SUBSCRIPTION_PRODUCT_ID=pdt_your_product_id
DODO_WEBHOOK_SECRET=whsec_your_secret

# --- Cloak & MagicBlock ---
CLOAK_API_KEY=cloak_your_api_key
# The private key for the backend signer (Base58)
CLOAK_PRIVATE_PAYMENT_SIGNER_KEY=your_base58_private_key
MAGICBLOCK_API_ENDPOINT=https://api.magicblock.io/v1

# --- Data APIs ---
DUNE_SIM_API_KEY=sim_your_api_key