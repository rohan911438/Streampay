{
  "version": 2,
  "installCommand": "npm install --no-audit --prefer-offline",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "framework": "nextjs",
  "outputDirectory": "apps/web/.next",
  "regions": ["sfo1"],
  "cleanUrls": true,
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
