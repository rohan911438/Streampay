{
  "name": "streampay-sdk",
  "version": "1.0.0",
  "description": "Privacy-first, cross-chain payment infrastructure SDK for Solana. Integrate Cloak-protected payments with MagicBlock execution layer.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "prepare": "npm run build",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "streampay",
    "payment",
    "payments",
    "solana",
    "web3",
    "blockchain",
    "sdk",
    "privacy",
    "cloak",
    "magicblock",
    "usdc",
    "crypto",
    "cryptocurrency",
    "subscription",
    "recurring"
  ],
  "author": "StreamPay Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streampay/streampay-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/streampay/streampay-sdk-js/issues"
  },
  "homepage": "https://github.com/streampay/streampay-sdk-js#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "prettier": "^3.1.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.8"
  }
}
